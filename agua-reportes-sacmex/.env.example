# Copia este archivo a .env si quieres cambiar algo; sin .env se usan estos valores.

# Puertos en el equipo anfitrión
DB_PORT=5442
WEB_PORT=8092

# Credenciales de la base (solo para uso local)
POSTGRES_DB=agua_dw
POSTGRES_USER=agua
POSTGRES_PASSWORD=agua_local

# Usuario con el que corren el ETL y la web (dueño de ./datos)
HOST_UID=1000
HOST_GID=1000

# Distancia máxima (m) a la manzana más cercana para ubicar un reporte
DISTANCIA_MAX_M=1000

# 1 = repetir el ETL aunque ya haya una carga con los mismos parámetros
FORZAR_ETL=0
# 1 = volver a descargar del portal aunque el archivo ya esté en ./datos
FORZAR_DESCARGA=0
