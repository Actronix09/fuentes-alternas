# Copia este archivo a .env si quieres cambiar algo; sin .env se usan estos valores.

# Puertos en el equipo anfitrión
DB_PORT=5441
WEB_PORT=8091
ORIGINAL_PORT=8094

# Credenciales de la base (solo para uso local)
POSTGRES_DB=sismos_dw
POSTGRES_USER=sismos
POSTGRES_PASSWORD=sismos_local

# Usuario con el que corren el ETL y la web (dueño de ./datos)
HOST_UID=1000
HOST_GID=1000

# Parámetros del ETL
USGS_MAG_MIN=3.5        # magnitud mínima que se descarga del USGS
SSN_MAG_MIN=4.0         # magnitud mínima del SSN que entra al análisis
VENTANA_SEG=30          # tolerancia de hora (s) desde ANIO_CORTE_HIST
DISTANCIA_KM=100        # tolerancia de distancia (km) desde ANIO_CORTE_HIST
VENTANA_SEG_HIST=120    # tolerancias para sismos históricos (antes de ANIO_CORTE_HIST)
DISTANCIA_KM_HIST=250
DELTA_MAG_MAX=1.0       # diferencia máxima de magnitud entre las dos fuentes
ANIO_CORTE_HIST=1964

# 1 = repetir el ETL aunque ya haya una carga con los mismos parámetros
FORZAR_ETL=0
# 1 = volver a descargar aunque el archivo ya esté en ./datos
FORZAR_DESCARGA=0
